# Ignore Virtual Environments and Package Dependencies
nexus_env/
env/
venv/
.venv/
node_modules/
__pycache__/

# Ignore Heavy Databases and Ledgers
*.db
*.ndjson
.env
ledgers/*_vault.json
ledgers/*.db

# Ignore Large Media and Encrypted Archives
*.tar.gz
*.enc
*.mp4
*.png
media_archive/
sync_archive/
B Image/

# Ignore Download Directories and Installers
*Downloads/
Downloads/
*.exe
*.msi
*.msix
*.zip
*.7z
*.rar

# Ignore Shortcuts and OS Metadata
*.lnk
*.url
desktop.ini
.DS_Store
